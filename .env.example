# Required on Vercel: Project → Settings → Environment Variables (Production + Preview).
# Without these, the storefront still loads but sign-in, cart persistence, and admin do not work.
# Copy Supabase → Settings → API: Project URL only (no /auth/v1 suffix). Same project as Auth; add production URLs under Authentication → URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: local dev default. On Vercel, do not leave this as localhost or payment redirects/webhooks will point at your machine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canonical HTTPS URL — set on Vercel Production (and Preview if needed) to your live URL, e.g. https://www.benizergreenshop.com
# Required for Moolre/Paystack so callbackUrl and redirectUrl match the site customers use (not *.vercel.app unless that is your real URL).
NEXT_PUBLIC_APP_URL=

SUPABASE_SERVICE_ROLE_KEY=
# Required for admin dashboard mutations (orders, leads, products, distributor account provisioning via Auth Admin API).

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Moolre (https://docs.moolre.com/) — if set, checkout uses Moolre instead of Paystack.
# MOOLRE_COLLECT_URL must be the full POST URL from your Moolre docs/dashboard (path varies by account/version).
# Preferred (2-key accounts):
MOOLRE_PRIVATE_API_KEY=
MOOLRE_PUBLIC_API_KEY=
# If the dashboard shows a separate public key string for API calls, set it here (sent as X-API-PUBKEY). Otherwise omit.
MOOLRE_API_PUBKEY=
# Set to true to always use userid from the JWT in MOOLRE_PUBLIC_API_KEY as X-API-USER (fixes wrong MOOLRE_API_USER on Vercel).
MOOLRE_FORCE_JWT_USERID=
# Only for /open/transact/payment: set true if Moolre support says to send the private key as X-API-KEY (default off — often causes AIN01).
MOOLRE_OPEN_INCLUDE_PRIVATE_HEADER=
# Legacy 4-header credentials (only if your account/docs specifically require them):
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_API_VASKEY=
MOOLRE_COLLECT_URL=
# Merchant wallet account number (Moolre dashboard). Required when MOOLRE_COLLECT_URL is .../embed/link (recommended for checkout).
MOOLRE_ACCOUNT_NUMBER=
# Amount unit: embed/link and /open/transact/payment default to GH₵ (major units). For custom MOOLRE_COLLECT_URL that expects pesewas (×100), set MOOLRE_AMOUNT_UNIT=pesewas.
MOOLRE_AMOUNT_UNIT=

# Optional webhook verification — leave empty unless Moolre sends this exact header value (otherwise 401).
MOOLRE_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

RESEND_API_KEY=
# Optional debug logs in server functions (Vercel logs): true/false
RESEND_DEBUG=false
# Optional — verified sender for Resend (production). Defaults to onboarding@resend.dev for testing only.
RESEND_FROM=
# Optional reply-to used on outgoing email headers (defaults to ADMIN_EMAIL/site email).
RESEND_REPLY_TO=
# Optional (testing only) — comma-separated allowed recipients when using onboarding@resend.dev.
RESEND_SANDBOX_ALLOWLIST=

# Lead notifications; defaults to siteConfig.email (benizergreens@gmail.com) if unset
ADMIN_EMAIL=

# Default admin (optional overrides for npm run seed:admin)
DEFAULT_ADMIN_EMAIL=admin@benizergreenshop.com
DEFAULT_ADMIN_PASSWORD=ChangeMeAdmin123!
