# Required on Vercel: Project → Settings → Environment Variables (Production + Preview).
# Without these, the storefront still loads but sign-in, cart persistence, and admin do not work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: used when Host headers are missing (e.g. some cron/email flows). Also set this URL in Supabase Auth → URL Configuration → Site URL & redirect allow list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canonical HTTPS URL for production — strongly recommended for Moolre/Paystack redirects (fallback: VERCEL_URL on Vercel).
NEXT_PUBLIC_APP_URL=

SUPABASE_SERVICE_ROLE_KEY=
# Required for admin dashboard mutations (orders, leads, products, distributor account provisioning via Auth Admin API).

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Moolre (https://docs.moolre.com/) — if all are set, checkout uses Moolre instead of Paystack.
# MOOLRE_COLLECT_URL must be the full POST URL from your Moolre API docs (path varies by product/version).
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_API_PUBKEY=
MOOLRE_API_VASKEY=
MOOLRE_COLLECT_URL=
# Amount: omit or pesewas — ×100 like Paystack. Set MOOLRE_AMOUNT_UNIT=ghs only if Moolre expects cedis instead.
MOOLRE_AMOUNT_UNIT=

# Optional webhook verification — leave empty unless Moolre sends this exact header value (otherwise 401).
MOOLRE_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

RESEND_API_KEY=
# Lead notifications; defaults to siteConfig.email (benizergreens@gmail.com) if unset
ADMIN_EMAIL=

# Default admin (optional overrides for npm run seed:admin)
DEFAULT_ADMIN_EMAIL=admin@benizergreenshop.com
DEFAULT_ADMIN_PASSWORD=ChangeMeAdmin123!
